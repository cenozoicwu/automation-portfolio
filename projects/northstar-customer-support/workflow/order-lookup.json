    {
      "parameters": {
        "jsCode": "// 只做订单号与邮箱的匹配和字段过滤\nconst request = $('When Executed by Another Workflow').first().json;\n\nconst orderId = String(request.order_id ?? '').trim();\nconst email = String(request.customer_email ?? '').trim().toLowerCase();\n\nconst rows = $input.all()\n  .map(item => item.json)\n  .filter(row => row.order_id);\n\nif (!orderId || !email) {\n  return [{\n    json: {\n      success: false,\n      status: 'MISSING_PARAMETERS',\n      message: 'Order ID and customer email are required.'\n    }\n  }];\n}\n\nconst order = rows.find(row =>\n  String(row.order_id).trim() === orderId &&\n  String(row.customer_email).trim().toLowerCase() === email\n);\n\nif (!order) {\n  return [{\n    json: {\n      success: false,\n      status: 'NOT_FOUND',\n      message: 'No matching order was found.'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    status: 'FOUND',\n    order: {\n      order_id: order.order_id,\n      order_status: order.status,\n      tracking_number: order.tracking_number || null,\n      carrier: order.carrier || null,\n      estimated_delivery: order.estimated_delivery || null\n    }\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
