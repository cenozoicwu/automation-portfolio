      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "id": "e2405367-26f1-4f23-88ca-366d128e2fc8",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst input = $input.item.json;\n\n// Normalize input fields\nconst sessionId = String(input.session_id ?? '').trim();\nconst email = String(input.customer_email ?? '').trim().toLowerCase();\nconst orderId = String(input.order_id ?? '').trim();\nconst issueType = String(input.issue_type ?? '').trim().toUpperCase();\nconst issueSummary = String(input.issue_summary ?? '').trim();\n\nconst customerConfirmed = input.customer_confirmed === true;\n\nconst allowedTypes = [\n  'DELIVERY_ISSUE',\n  'DAMAGED_ITEM',\n  'REFUND_REQUEST',\n  'COMPENSATION_REQUEST',\n  'PAYMENT_DISPUTE',\n  'OTHER'\n];\n\nconst errors = [];\n\n// Validate customer consent\nif (!customerConfirmed) {\n  errors.push('Customer confirmation is required');\n}\n\n// Validate required fields\nif (!sessionId) {\n  errors.push('Session ID is required');\n}\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) || email.length > 254) {\n  errors.push('Valid customer email is required');\n}\n\nif (!allowedTypes.includes(issueType)) {\n  errors.push('Invalid issue type');\n}\n\nif (issueSummary.length < 10 || issueSummary.length > 1000) {\n  errors.push('Issue summary must be 10-1000 characters');\n}\n\n// Return validation result\nreturn {\n  json: {\n    session_id: sessionId,\n    customer_email: email,\n    order_id: orderId,\n    issue_type: issueType,\n    issue_summary: issueSummary,\n    customer_confirmed: customerConfirmed,\n    validation_passed: errors.length === 0,\n    validation_error: errors.join('; ')\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "f7c51b21-eaae-4ae3-94c0-1c7c097491f9",
