      "id": "9b98e86d-223d-4fb6-a8a4-841ed2041f9d",
      "name": "Check Existing Ticket",
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIALS_ID",
          "name": "Google Sheets account"
        }
