    {
      "parameters": {
        "jsCode": "\nconst request = $('Validate Ticket Request').first().json;\n\nconst existingRows = $input.all()\n  .map(item => item.json)\n  .filter(row => row.ticket_id);\n\nconst normalize = value =>\n  String(value ?? '')\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, ' ');\n\n// Detect explicit compensation intent in a ticket summary\nconst hasCompensationIntent = summary =>\n  /\\b(compensation|compensate|reimbursement|reimburse|goodwill credit)\\b|赔偿|补偿/i\n    .test(String(summary ?? ''));\n\n// Check whether two issue types represent the same request\nconst isSameIssue = (row, currentRequest) => {\n  const existingType = normalize(row.issue_type);\n  const requestedType = normalize(currentRequest.issue_type);\n\n  if (existingType === requestedType) {\n    return true;\n  }\n\n  const isDeliveryCompensationPair =\n    [existingType, requestedType].includes('delivery_issue') &&\n    [existingType, requestedType].includes('compensation_request');\n\n  if (isDeliveryCompensationPair) {\n    return (\n      hasCompensationIntent(row.issue_summary) &&\n      hasCompensationIntent(currentRequest.issue_summary)\n    );\n  }\n\n  return false;\n};\n\nconst duplicate = existingRows.find(row =>\n  normalize(row.customer_email) === normalize(request.customer_email) &&\n  normalize(row.order_id) === normalize(request.order_id) &&\n  normalize(row.ticket_status) === 'open' &&\n  isSameIssue(row, request)\n);\n\nreturn [\n  {\n    json: {\n      ...request,\n      is_duplicate: Boolean(duplicate),\n      existing_ticket_id: duplicate?.ticket_id ?? '',\n      existing_notification_status:\n        duplicate?.notification_status ?? ''\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -96
      ],
