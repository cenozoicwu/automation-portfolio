      "id": "a59b8c16-1a8c-4226-aeec-ff9d22cc647f",
      "name": "Append Agent Error Log",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst input = $input.item.json;\nconst message = String(input.error_message ?? '');\n\nlet errorType = 'UNKNOWN_ERROR';\nlet safeMessage = 'Unclassified model execution error';\n\n// Order matters: check specific errors first.\nif (\n  /model_not_found|model (?:not exist|does not exist|not found)/i.test(message)\n) {\n  errorType = 'MODEL_NOT_FOUND';\n  safeMessage = 'Requested AI model was not found';\n\n} else if (\n  /\\b(401|403)\\b|unauthorized|forbidden|invalid api key|authentication failed/i.test(message)\n) {\n  errorType = 'AUTH_ERROR';\n  safeMessage = 'Model authentication or access denied';\n\n} else if (\n  /\\b429\\b|rate.limit|too many requests|quota exceeded/i.test(message)\n) {\n  errorType = 'RATE_LIMIT';\n  safeMessage = 'Model API rate limit or quota exceeded';\n\n} else if (\n  /\\b(408|504)\\b|timed? out|timeout/i.test(message)\n) {\n  errorType = 'TIMEOUT';\n  safeMessage = 'Model request timed out';\n\n} else if (\n  /\\b(500|502|503)\\b|service unavailable|bad gateway/i.test(message)\n) {\n  errorType = 'SERVICE_UNAVAILABLE';\n  safeMessage = 'Model service temporarily unavailable';\n\n} else if (\n  /\\b404\\b|resource.*not.*found|could not be found/i.test(message)\n) {\n  errorType = 'RESOURCE_NOT_FOUND';\n  safeMessage = 'Requested model resource was not found';\n\n} else if (\n  /\\b400\\b|invalid request|bad request/i.test(message)\n) {\n  errorType = 'INVALID_REQUEST';\n  safeMessage = 'Model request was invalid';\n\n} else if (\n  /\\bfetch failed\\b|ECONNREFUSED|ENOTFOUND|EAI_AGAIN|network error|connection refused/i.test(message)\n) {\n  errorType = 'NETWORK_ERROR';\n  safeMessage = 'Model network request failed';\n\n} else if (\n  input.error_type === 'MODEL_EXECUTION_FAILED'\n) {\n  errorType = 'MODEL_EXECUTION_FAILED';\n  safeMessage = 'Model execution failed';\n}\n\n\nreturn {\n  json: {\n    model_provider: input.model_provider ?? 'unknown',\n    error_type: errorType,\n    error_message: safeMessage,\n    raw_error_message: message,\n    session_id: input.session_id ?? 'unknown',\n    execution_id: input.execution_id ?? 'unknown'\n  }\n};\n\n"
      },
