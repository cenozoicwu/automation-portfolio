    {
      "parameters": {
        "jsCode": "\nconst lead = $('Validate & Score').first().json;\nconst history = $input.all().map(item => item.json);\n\nconst email = String(lead.email).trim().toLowerCase();\n\nconst existing = history.find(row =>\n  String(row.email || '').trim().toLowerCase() === email\n);\n\nreturn [{\n  json: {\n    ...lead,\n    lead_id: `lead-${$execution.id}`,\n    is_duplicate: Boolean(existing)\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        80
      ],
      "id": "3bce9ba0-7dbc-4ada-81d8-076ab3dcc542",
      "name": "Check Duplicate"
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\n\n// 1. 标准化字段\nconst name = String(lead.name || '').trim();\nconst email = String(lead.email || '').trim().toLowerCase();\nconst company = String(lead.company || '').trim();\nconst interest = String(lead.interest || '').trim();\n\n// 2. 基础验证\nif (!name) throw new Error('Missing customer name');\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  throw new Error('Invalid email address');\n}\n\n// 3. 根据业务规则计算分数（示例规则）\nlet score = 20;\n\nif (company) score += 20;\nif (interest.length >= 15) score += 15;\n\nif (/automation|crm|integration|workflow/i.test(interest)) {\n  score += 30;\n}\n\nif (/consulting|agency|software|technology/i.test(company)) {\n  score += 15;\n}\n\nscore = Math.min(score, 100);\n\nconst priority =\n  score >= 70 ? 'High' :\n  score >= 40 ? 'Medium' : 'Low';\n\n// 获取中国上海当前时间（格式化为可读的字符串，例如：2026/10/29 23:05:00）\nconst shanghaiTime = new Date().toLocaleString(\"zh-CN\", {\n  timeZone: \"Asia/Shanghai\",\n  hour12: false // 使用 24 小时制\n});\n\n// 4. 输出标准化数据\nreturn [{\n  json: {\n    ...lead,\n    name,\n    email,\n    company,\n    interest,\n    lead_score: score,\n    priority,\n    qualified_at: shanghaiTime // 替换为上海时间\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        80
      ],
      "id": "9868e81c-9aea-4826-8250-f9f1da2c5545",
      "name": "Validate & Score"
    },
    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\nconst body = input.body;\n\nconst errors = [];\n\nconst validBody =\n  body !== null &&\n  typeof body === 'object' &&\n  !Array.isArray(body);\n\nif (!validBody) {\n  errors.push('Request body must be a JSON object');\n}\n\nconst data = validBody ? body : {};\n\nfunction getString(field, maxLength = 500) {\n  const value = data[field];\n\n  if (value === undefined || value === null) {\n    return '';\n  }\n\n  if (typeof value !== 'string') {\n    errors.push(`${field} must be a string`);\n    return '';\n  }\n\n  const cleaned = value.trim();\n\n  if (cleaned.length > maxLength) {\n    errors.push(`${field} exceeds ${maxLength} characters`);\n  }\n\n  return cleaned;\n}\n\nconst name = getString('name', 100);\nconst email = getString('email', 254).toLowerCase();\nconst company = getString('company', 200);\nconst interest = getString('interest', 2000);\nconst source = getString('source', 100);\n\nif (!name) {\n  errors.push('Name is required');\n}\n\nif (!email) {\n  errors.push('Email is required');\n} else if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  errors.push('Invalid email format');\n}\n\nreturn [{\n  json: {\n    is_valid: errors.length === 0,\n    errors,\n    name,\n    email,\n    company,\n    interest,\n    source,\n    received_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        176
