    {
      "parameters": {
        "sendTo": "REPLACE_WITH_NOTIFICATION_EMAIL",
        "subject": "={{ '[Recovered Lead] ' + $('Prepare Retry').item.json.company }}",
        "emailType": "text",
        "message": "={{   'Recovered Sales Lead Notification\\n\\n' +   'Name: ' + $('Prepare Retry').item.json.name + '\\n' +   'Email: ' + $('Prepare Retry').item.json.email + '\\n' +   'Company: ' + $('Prepare Retry').item.json.company + '\\n' +   'Interest: ' + $('Prepare Retry').item.json.interest + '\\n' +   'Lead ID: ' + $('Prepare Retry').item.json.lead_id + '\\n\\n' +   'Please follow up with this lead.' }}",
