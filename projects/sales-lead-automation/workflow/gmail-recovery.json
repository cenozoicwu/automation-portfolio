      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1408,
        144
      ],
      "id": "21ee95ae-d448-48df-a7c7-a860bd86ecb2",
      "name": "Send a message",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst lead = $('Prepare Retry').item.json;\nconst error = $input.item.json.error || {};\n\nconst message = String(\n  error.message ||\n  $input.item.json.message ||\n  'Unknown Gmail error'\n);\n\nconst attempts = Number(lead.notification_attempts);\n\n// 仅示范明确收到 429 限流拒绝的情况\nconst rateLimited = /\\b429\\b|rate.?limit/i.test(message);\n\n// 超过重试次数，或发送结果不确定，转人工检查\nconst status =\n  rateLimited && attempts < 3\n    ? 'FAILED'\n    : 'REVIEW';\n\nreturn {\n  json: {\n    lead_id: lead.lead_id,\n    notification_status: status,\n    notification_attempts: attempts,\n    last_error: message,\n    last_attempt_at: new Date().toISOString()\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        336
      ],
      "id": "01f2b4f3-9af7-4d67-9141-2a72f73e5949",
